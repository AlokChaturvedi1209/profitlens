# Change this secret before deploying outside localhost
APP_SECRET=replace-this-with-a-long-random-private-string
POSTGRES_USER=profitlens
POSTGRES_PASSWORD=profitlens_local_only
POSTGRES_DB=profitlens
DATABASE_URL=postgresql+psycopg://profitlens:profitlens_local_only@db:5432/profitlens
SEED_DEMO=true
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
MONITOR_INTERVAL_SECONDS=900
# Optional SMTP (never commit actual secrets)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_TO_EMAIL=
# Optional AI (without this, built-in answers still work)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
